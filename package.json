{
  "name": "task6-blog-api",
  "version": "1.0.0",
  "description": "Blog REST API built with Express, TypeScript and Mongoose (sessions in MongoDB)",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mongoose": "^8.9.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/swagger-ui-express": "^4.1.7",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
